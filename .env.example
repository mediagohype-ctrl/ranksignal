# --- Core ---
# Neon pooled connection (add pgbouncer=true) for the app, and the direct (non "-pooler") host for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# 32-byte hex key for AES-256-GCM encryption of integration credentials
CREDENTIALS_KEY=""
APP_URL="http://localhost:3000"
RUN_WORKER_IN_APP="true"

# --- Our own SEO / GEO (all optional) ---
# Search console ownership tags: paste only the content="..." value of each meta tag.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
YANDEX_SITE_VERIFICATION=""
# IndexNow key (8–128 letters/digits/dashes) served at /indexnow.txt; ping after deploys with `npm run indexnow`.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=""
# Official brand profiles for Organization.sameAs and the footer's profile links
# (comma-separated https URLs: Instagram, YouTube, X, LinkedIn, Crunchbase, G2…).
BRAND_SAME_AS=""
# Business address for Organization.address (PostalAddress), the footer ("Town, Country") and the legal pages.
# All optional: the address is emitted once a town (or street) is set; street and postal code may stay empty.
# Nothing is shown while these are empty. There is deliberately no phone number setting.
BRAND_ADDRESS_STREET=""
BRAND_ADDRESS_LOCALITY=""
BRAND_ADDRESS_REGION=""
BRAND_ADDRESS_POSTAL_CODE=""
# ISO 3166-1 alpha-2 country code (default IN).
BRAND_ADDRESS_COUNTRY="IN"

# --- AI providers (all optional) ---
# Crawl-based SEO / AEO / GEO reports are ALWAYS real (they only need the website).
# AI visibility (does ChatGPT/Gemini/Perplexity mention or cite you?) needs at least one key below.
# With NO key configured, visibility runs use clearly-labelled SIMULATED demo answers instead.
# Every configured provider is used on each run (1 credit per prompt per provider); a provider can be
# switched off without removing its key via the admin feature flag provider.<id> (openai/gemini/perplexity/dataforseo).
# The first configured of OPENAI_API_KEY, then GEMINI_API_KEY, also powers AI-written drafts, prompt research
# and the "does AI know your brand?" check; without either, those fall back to templates/heuristics.

# Google Gemini API with Grounding with Google Search. Keys from Google AI Studio (https://aistudio.google.com/apikey).
# A free tier is available — check current free-tier limits (requests/day, grounding allowance) before relying on it.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Perplexity Sonar API (paid, usage-based; https://www.perplexity.ai/settings/api).
PERPLEXITY_API_KEY=""
PERPLEXITY_MODEL="sonar"

# OpenAI Responses API with web search (ChatGPT-style answers; paid, usage-based).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Licensed AI visibility data provider (blueprint §8.2 P0)
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
# Backlink checker + link gap use DataForSEO's Backlinks API, a SEPARATE monthly subscription on the DataForSEO
# account. Set to "true" only after activating it (until then the pages say backlink data isn't switched on yet).
DATAFORSEO_BACKLINKS_ENABLED="false"
# The same DataForSEO login also enables "Google AI Overviews" and "Google AI Mode" as AI-check platforms (SERP API,
# ~USD 0.004 per question each). Switch either off with the provider.google_aio / provider.google_ai_mode feature flags.

# AI crawler visits: check crawler IPs against OpenAI/Perplexity/Google/Bing published ranges (fetched daily from
# their sites). "false" = never fetch; visits are then labelled "claimed by user agent".
AI_BOT_IP_VERIFY="true"

# Simulated demo data is only used when no real provider above is configured.
# Set to "false" in production to disable it entirely (runs then fail with "no provider configured").
ALLOW_SIMULATED_PROVIDER="true"

# --- Billing (Razorpay) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Razorpay plan ids (Dashboard → Subscriptions → Plans), one per paid plan. Checkout for a plan is offered only when
# its id is set; otherwise the billing page shows "Payments are coming soon — contact us to upgrade".
# Razorpay charges the amount set ON THE PLAN, so each plan's amount must be price + GST (monthly, every 1 month):
# with 18% GST: Starter ₹2,358.82 (₹1,999 + ₹359.82), Growth ₹9,438.82 (₹7,999 + ₹1,439.82),
# Agency ₹23,598.82 (₹19,999 + ₹3,599.82). Without GSTIN: the plain price. Admin → System shows a warning when
# a configured plan's amount differs. Plan amounts can't be edited in Razorpay: create a new plan and change the id.
RAZORPAY_PLAN_STARTER=""
RAZORPAY_PLAN_GROWTH=""
RAZORPAY_PLAN_AGENCY=""

# --- GST (src/lib/billing/gst.ts) ---
# Our GST number. GST is charged ONLY when this is set: prices then show "+ GST", checkout shows price + GST = total,
# and every payment gets a GST tax invoice (Settings → Billing → Invoices). Unset = not registered: plain prices, no GST.
GSTIN=""
# GST rate in percent added on top of every price (default 18).
GST_RATE_PERCENT="18"
# Legal name exactly as on the GST certificate (printed on invoices; default: LEGAL_ENTITY in src/lib/site.ts).
GST_LEGAL_NAME=""
# Our state's 2-digit GST code (default: first 2 digits of GSTIN, else 07 = Delhi). Customers in the same state pay
# CGST + SGST; other states pay IGST. Customers who haven't entered billing details are treated as our state.
GST_STATE_CODE="07"
# SAC code printed on invoices. Default 998314 (IT design and development services) — ask your CA to confirm.
GST_SAC_CODE="998314"
# Invoice number prefix: PREFIX/2026-27/000001, numbered per Indian financial year (April–March).
GST_INVOICE_PREFIX="MWR"
# Invoices print the business address from BRAND_ADDRESS_* above (no phone number).

# --- AI cost protection ---
# Hard cap on total AI provider spend per UTC day across ALL organizations (USD; default 5). When reached, new AI
# calls are refused (visibility checks record the remaining questions as failed, AI drafts fall back to templates)
# and staff get one "Daily AI budget reached" notification per day. "0" pauses all AI calls.
AI_DAILY_BUDGET_USD="5"

# --- Accounts: email + captcha (all optional; features degrade gracefully when unset) ---
# Resend API key (https://resend.com) for verification, password-reset, invite and security emails. Unset = emails are skipped.
RESEND_API_KEY=""
# Sender for transactional email; the domain must be verified in Resend, e.g. "MyWebRank <info@mywebrank.tech>".
EMAIL_FROM=""
# Hidden copy of every email except one-time login/reset/invite links (comma-separated)
EMAIL_BCC=""
# Where customer replies go when an email does not set its own
EMAIL_REPLY_TO=""
# Cloudflare Turnstile site key (public) — renders the captcha widget on sign-up and after repeated failed sign-ins.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Cloudflare Turnstile secret key (server) — enables captcha verification. Set BOTH keys or neither.
TURNSTILE_SECRET_KEY=""
# Optional comma-separated extra throwaway-inbox domains to block at sign-up, and domains to allow despite the built-in list.
DISPOSABLE_EMAIL_DOMAINS=""
ALLOWED_EMAIL_DOMAINS=""

# --- Email via SMTP (takes priority over Resend when set), e.g. Hostinger: smtp.hostinger.com, 465, SSL ---
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""

# "Continue with Google" sign-in (same OAuth client as Search Console is fine).
# Add {APP_URL}/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Staff alerts: AI spend at 80%/100%, failed jobs and payments, trials ending.
STAFF_ALERT_EMAIL=
STAFF_WHATSAPP=

# WhatsApp updates (Meta WhatsApp Cloud API). Customer updates need an approved template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_UPDATE_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
STAFF_WHATSAPP_TEMPLATE=

# Optional: flat per-call estimate used to reserve AI budget for OpenRouter calls.
OPENROUTER_CALL_ESTIMATE_USD=
# Optional: cheap OpenRouter model for the free AI writing tools (title, meta description, FAQ). Default google/gemini-3.8-flash.
OPENROUTER_TOOLS_MODEL=
# Set to true to stop all growth messages (trial nudges, fix of the week, competitor alerts).
GROWTH_MESSAGES_DISABLED=
# Optional: Google PageSpeed Insights API key (Google Cloud, enable "PageSpeed Insights API"). Works without a key
# at a lower shared quota; a key raises it. Used for real Core Web Vitals after each crawl.
PAGESPEED_API_KEY=
# Set to 0 to skip the headless-browser comparison for JavaScript-only sites.
CRAWLER_RENDER=
# Google Business Profile monitor (Places API (New)). Google Cloud: enable "Places API (New)", create an API key,
# restrict it to that API (server-side key; no referrer restriction). Unset = the Business Profile page explains setup.
GOOGLE_PLACES_API_KEY=
# Set to true to stop customer alerts (score drops, site down, AI mentions, Google clicks...). Default: alerts on.
ALERTS_DISABLED=
