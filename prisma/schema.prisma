// Data model — blueprint §7. PostgreSQL (Neon). DATABASE_URL = pooled connection for the app;
// DIRECT_URL = non-pooled connection for migrations. Every tenant-owned row carries organizationId.
// JSON columns are stored as Json; status/enum-like columns are strings validated in code
// (see src/lib/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // non-pooled connection used by prisma migrate
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  region            String   @default("IN")
  billingCustomerId String?
  planId            String   @default("trial") // trial | starter | growth | agency
  status            String   @default("active") // active | past_due | cancelled | suspended
  publishingEnabled Boolean  @default(true) // per-tenant kill switch
  serviceTier       String? // done-for-you tier: fix | grow | authority (null = self-serve)
  branding          Json? // white-label: { displayName, logoUrl, accentColor, replyTo, footerText } (agency plan)
  whatsappNumber    String? // E.164, for WhatsApp updates (brief §9)
  whatsappOptIn     Boolean  @default(false)
  referralCode      String?  @unique
  referredById      String? // organization that referred this one
  isInternal        Boolean  @default(false) // our own team workspace (staff accounts); excluded from revenue metrics
  createdAt         DateTime @default(now())

  memberships   Membership[]
  projects      Project[]
  integrations  Integration[]
  subscriptions Subscription[]
  usage         UsageLedger[]
  auditLogs     AuditLog[]
  workflowRuns  WorkflowRun[]
  notifications Notification[]
  adminNotes    AdminNote[]
  apiKeys       ApiKey[]
  reportTemplates ReportTemplate[]
  dataForSeoUsage DataForSeoUsage[]
  competitorSnapshots CompetitorSnapshot[]
  researchSearches ResearchSearch[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  emailVerified Boolean  @default(false)
  isStaff       Boolean  @default(false)
  staffRoles    String[] @default([]) // admin back-office roles (src/lib/admin/rbac.ts); only used when isStaff
  timeZone      String? // IANA zone, e.g. "Asia/Kolkata"; dates are stored UTC and shown in this zone
  expertMode    Boolean  @default(false) // show SEO/AEO/GEO scores, risk classes and raw tables
  googleId      String?  @unique // "Continue with Google" sign-in
  createdAt     DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  role           String    @default("member") // owner | admin | member | viewer
  status         String    @default("active") // active | invited | removed
  invitedAt      DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  websiteUrl     String
  brandNames     Json?      // string[] brand name + aliases
  categories     Json?      // product/service categories
  audience       String?
  countries      Json?     
  languages      Json?     
  competitors    Json?      // {name, domain, aliases[]}[]
  keywords       Json?     
  settings       Json?      // crawl limits, schedules, automation permissions
  facts          Json?      // business facts the owner confirmed in setup: {name, sells, customers, city, country, language}
  createdAt      DateTime @default(now())

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources     Resource[]
  crawlRuns     CrawlRun[]
  findings      AuditFinding[]
  prompts       TrackedPrompt[]
  visibilityRuns VisibilityRun[]
  actions       Action[]
  integrations  Integration[]
  snapshots     ReportSnapshot[]
  tasks         Task[]
  monthlyReports MonthlyReport[]
  offsiteItems  OffsiteItem[]
  dailyMetrics  MetricDaily[]
  keywordStars  KeywordStar[]
  backlinkMonitor BacklinkMonitor?
  backlinkSnapshots BacklinkSnapshot[]
  linkGapReports LinkGapReport[]
  trackedKeywords TrackedKeyword[]
  rankTrackerState RankTrackerState?
  businessProfile BusinessProfile?
  aiBotDaily    AiBotDaily[]
  aiBotImports  AiBotLogImport[]
  aiBotIngestKey AiBotIngestKey?
  indexNowSite  IndexNowSite?
  indexNowSubmissions IndexNowSubmission[]
  alertSettings AlertSettings?
  alertEvents   AlertEvent[]
  reportTemplates ReportTemplate[]
  competitorSnapshots CompetitorSnapshot[]
  researchSearches ResearchSearch[]

  @@index([organizationId])
}

model Integration {
  id                  String    @id @default(cuid())
  organizationId      String
  projectId           String?
  provider            String // wordpress | github | gsc | manual | crawler
  credentialEncrypted String? // AES-GCM ciphertext; never logged or sent to client
  scopes              Json?      
  capabilities        Json?       // capability snapshot
  health              String    @default("unknown") // healthy | degraded | failed | unknown
  connectorVersion    String    @default("1")
  config              Json?       // non-secret config, e.g. siteUrl
  connectedBy         String?
  lastSyncAt          DateTime?
  createdAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
}

model Resource {
  id                 String   @id @default(cuid())
  organizationId     String
  projectId          String
  canonicalUrl       String
  resourceType       String   @default("page")
  cmsResourceId      String?
  lastSeen           DateTime @default(now())
  status             String   @default("active")
  contentFingerprint String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, canonicalUrl])
  @@index([organizationId])
}

model CrawlRun {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  workflowRunId  String?
  status         String    @default("queued")
  pagesFound     Int       @default(0)
  pagesCrawled   Int       @default(0)
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages   CrawlPage[]
  auditDepth AuditDepthRun?
  pageSpeedResults PageSpeedResult[]

  @@index([organizationId, projectId, createdAt])
}

model CrawlPage {
  id              String   @id @default(cuid())
  organizationId  String
  crawlRunId      String
  url             String
  finalUrl        String?
  statusCode      Int?
  redirectChain   Json?     
  contentType     String?
  responseBytes   Int?
  extracted       Json?      // title, description, headings, canonical, robotsMeta, links, images, jsonLd, wordCount
  error           String?
  crawledAt       DateTime @default(now())

  crawlRun CrawlRun       @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  findings AuditFinding[]

  @@index([crawlRunId])
}

model AuditFinding {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  crawlPageId    String?
  pageUrl        String?
  category       String // technical | content | metadata | schema | indexability | links | ai_readiness
  code           String // stable rule id e.g. missing_meta_description
  severity       String // critical | high | medium | low | info
  confidence     Float     @default(1)
  message        String
  evidence       Json?      
  status         String    @default("open") // open | resolved | ignored
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crawlPage CrawlPage? @relation(fields: [crawlPageId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId, status])
}

model TrackedPrompt {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  text           String
  intent         String   @default("informational") // informational | commercial | comparison | navigational | transactional
  topic          String?
  locale         String   @default("en-IN")
  targetProvider String   @default("all")
  priority       Int      @default(2)
  active         Boolean  @default(true)
  promptSetVersion Int    @default(1)
  createdAt      DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@index([organizationId, projectId, active])
}

model VisibilityRun {
  id               String    @id @default(cuid())
  organizationId   String
  projectId        String
  workflowRunId    String?
  status           String    @default("queued")
  providers        Json?      
  promptSetVersion Int       @default(1)
  sampleSize       Int       @default(0)
  collected        Int       @default(0)
  failed           Int       @default(0)
  costMicros       Int       @default(0) // cost in micro-USD
  metrics          Json?       // computed VisibilityMetrics snapshot
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@index([organizationId, projectId, createdAt])
}

model Observation {
  id                String   @id @default(cuid())
  organizationId    String
  visibilityRunId   String
  promptId          String
  provider          String // e.g. openai, dataforseo, simulated
  platformLabel     String // e.g. "ChatGPT (API: gpt-4o-mini)"
  model             String?
  locale            String?
  rawResponse       String // raw answer text (large payloads → object storage later)
  rawPayloadRef     String?
  citations         Json?      // {url, domain, title?, ownedByCustomer}[]
  brandMentioned    Boolean  @default(false)
  brandRecommended  Boolean  @default(false)
  brandCited        Boolean  @default(false)
  competitorMentions Json?     // name -> count
  sentiment         String?  // positive | neutral | negative
  parseConfidence   Float    @default(1)
  limitations       String?
  costMicros        Int      @default(0)
  simulated         Boolean  @default(false) // true for demo provider — always labelled in UI
  createdAt         DateTime @default(now())

  visibilityRun VisibilityRun @relation(fields: [visibilityRunId], references: [id], onDelete: Cascade)
  prompt        TrackedPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([organizationId, visibilityRunId])
  @@index([visibilityRunId, createdAt])
  @@index([promptId])
}

model Action {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  type           String // update_meta_description | update_title | add_faq_schema | content_brief | ...
  target         Json?       // {resourceType, resourceId, url}
  rationale      String
  evidenceRefs   Json?      
  priority       String    @default("medium") // critical | high | medium | low
  priorityScore  Float     @default(0)
  expectedImpact String?
  effort         String    @default("low")
  confidence     Float     @default(0.5)
  riskClass      String    @default("C") // A | B | C | D
  policyDecision String    @default("approval_required") // auto_execute | approval_required | blocked
  policyReason   String?
  policyVersion  String    @default("1")
  proposedChange Json?       // {field, before, after}
  draftHash      String?
  status         String    @default("proposed") // proposed | awaiting_approval | approved | rejected | expired | executing | succeeded | succeeded_with_warnings | failed | rollback_pending | rolled_back | rollback_failed | blocked | cancelled
  integrationId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvals  Approval[]
  executions ActionExecution[]

  @@index([organizationId, projectId, status])
}

model Approval {
  id          String    @id @default(cuid())
  organizationId String
  actionId    String
  requestedBy String?
  approverId  String?
  draftHash   String
  decision    String    @default("pending") // pending | approved | rejected | expired | invalidated
  comments    String?
  expiresAt   DateTime
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
}

model ActionExecution {
  id              String    @id @default(cuid())
  organizationId  String
  actionId        String
  connector       String
  idempotencyKey  String    @unique
  beforeState     Json?
  expectedVersion String?
  result          String    @default("pending") // pending | success | partial | failure
  resultDetail    Json?      
  validation      String?   // passed | warning | failed
  rollbackStatus  String?   // not_needed | pending | rolled_back | failed | manual_required
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
}

model WorkflowRun {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String?
  kind           String // crawl | visibility | analyze | execute_action | rollback | scheduled
  version        String    @default("1")
  state          String    @default("queued") // see WorkflowState in src/lib/types.ts
  idempotencyKey String?   @unique
  input          Json?      
  output         Json?      
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAfter       DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  error          String?
  errorClass     String?   // transient | permanent | policy | quota
  usage          Json?      
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       WorkflowEvent[]

  @@index([state, runAfter])
  @@index([organizationId, projectId])
}

model WorkflowEvent {
  id            String   @id @default(cuid())
  workflowRunId String
  name          String // e.g. crawl.started — see Appendix A event names
  fromState     String?
  toState       String?
  data          Json?     
  createdAt     DateTime @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
}

model Subscription {
  id                     String    @id @default(cuid())
  organizationId         String
  provider               String    @default("razorpay") // razorpay | stripe
  providerCustomerId     String?
  providerSubscriptionId String?   @unique
  planId                 String
  status                 String // trialing | active | past_due | cancelled | expired
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model UsageLedger {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  provider       String // openai | dataforseo | crawler | simulated
  taskType       String // crawl_page | visibility_prompt | llm_analysis | content_generation
  runId          String?
  kind           String   @default("actual") // reservation | actual | release
  credits        Int
  costMicros     Int      @default(0)
  billingPeriod  String // YYYY-MM
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, billingPeriod])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, eventId]) // replay protection / idempotency
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  actorType      String   @default("user") // user | system | staff
  action         String
  resourceType   String?
  resourceId     String?
  before         Json?
  after          Json?
  requestId      String?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  type           String // approval_requested | change_completed | job_failed | usage_threshold | monthly_report
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, readAt])
}

model FeatureFlag {
  key       String   @id // e.g. global.publishing, provider.openai, action.update_meta_description
  enabled   Boolean  @default(true)
  note      String?
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------------------------
// Round 4: measurement history, service delivery, monthly impact reports, admin records.

/** Frozen scores after each successful crawl / visibility run, so change over time can be shown. */
model ReportSnapshot {
  id                 String   @id @default(cuid())
  organizationId     String
  projectId          String
  kind               String // crawl | visibility
  crawlRunId         String?
  visibilityRunId    String?
  overallScore       Int?
  grade              String?
  pillarScores       Json? // { seo, aeo, geo, brand } -> number | null
  openIssues         Json? // { critical, high, medium, low, info, total }
  visibility         Json? // VisibilityMetrics subset (rates, index, competitorShare, sampleSize, providers)
  promptSetVersion   Int?
  methodologyVersion String
  simulated          Boolean  @default(false)
  report             Json? // full SiteReport built once when the run finished (served to report pages)
  createdAt          DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
  @@index([projectId, kind, createdAt])
}

/** Work items for the service team or the client (on-site fixes, content, off-site, reporting). */
model Task {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  actionId       String?
  findingId      String?
  title          String
  description    String?
  category       String    @default("onsite") // onsite | content | technical | offsite | reporting | other
  performedBy    String    @default("agency") // agency | client | system
  assigneeId     String?
  createdById    String?
  status         String    @default("backlog") // backlog | in_progress | client_review | done | blocked | cancelled
  priority       String    @default("medium") // high | medium | low
  dueAt          DateTime?
  completedAt    DateTime?
  clientVisible  Boolean   @default(true)
  shippedUrl     String?
  evidence       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments TaskComment[]

  @@index([organizationId, projectId, status])
  @@index([projectId, completedAt])
}

model TaskComment {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  authorId       String?
  body           String
  internal       Boolean  @default(false) // staff-only note, hidden from client viewers
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/** One impact report per project per month: drafted automatically, reviewed by staff, then sent. */
model MonthlyReport {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  period         String // YYYY-MM
  status         String    @default("draft") // draft | reviewed | sent
  payload        Json? // frozen report data (see src/lib/monthly-report/types.ts)
  summary        String? // editable narrative
  reviewedById   String?
  reviewedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, period])
  @@index([organizationId, period])
}

/** Inbound leads: free checks and contact-form messages (admin CRM). */
model Lead {
  id        String   @id @default(cuid())
  source    String // free_check | contact | signup_intent
  email     String?
  name      String?
  company   String?
  url       String?
  message   String?
  score     Int?
  ipHash    String?
  status    String   @default("new") // new | contacted | qualified | converted | closed
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, createdAt])
  @@index([status, createdAt])
}

/** Internal staff notes on a customer organization. */
model AdminNote {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/** Off-site GEO work: directory listings, review platforms, PR mentions, forums, entity profiles. */
model OffsiteItem {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  type           String // directory | review_platform | pr_mention | forum_thread | wikidata | social_profile | best_list | other
  name           String // e.g. "Justdial", "G2", "Inc42 article"
  url            String?
  status         String    @default("todo") // todo | submitted | live | rejected
  napConsistent  Boolean? // name/address/phone matches the site
  source         String    @default("manual") // manual | ai_citation (suggested from domains AI already cites)
  taskId         String?
  notes          String?
  liveAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, status])
}

/** Daily first-party metrics from Google Search Console / GA4 (and later others). */
model MetricDaily {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  source         String // gsc | ga4
  date           String // YYYY-MM-DD
  dimension      String   @default("total") // total | query | page | channel
  key            String   @default("") // the query, page URL or channel name ("" for total)
  clicks         Int?
  impressions    Int?
  ctr            Float?
  position       Float?
  sessions       Int?
  conversions    Int?
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, source, date, dimension, key])
  @@index([organizationId, projectId, source, date])
}

/** Idempotency log for outbound messages (trial nudges, weekly emails, WhatsApp, alerts): one row per kind+key. */
model SentMessage {
  id             String   @id @default(cuid())
  organizationId String?
  channel        String // email | whatsapp | staff
  kind           String // e.g. trial_day1, fix_of_week, competitor_alert, staff_ai_budget_80
  key            String // dedupe key, e.g. "<orgId>" or "<orgId>:2026-W45"
  createdAt      DateTime @default(now())

  @@unique([kind, key])
  @@index([organizationId, createdAt])
}

/** Our own blog (mywebrank.tech/blog), written by the team in /admin/content. Body is Markdown. */
model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  metaTitle     String?
  description   String
  /** Short direct answer shown first (AEO): what answer engines and AI Overviews quote. */
  answer        String    @default("")
  body          String
  keyPoints     String[]  @default([])
  faqs          Json? // [{ q, a }]
  keywords      String[]  @default([]) // first = primary search phrase
  category      String    @default("SEO")
  coverImageUrl String?
  authorName    String
  authorId      String?
  status        String    @default("draft") // draft | review | published | archived
  noindex       Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, publishedAt])
}

/** Search phrases we want to rank for (Google) and be named for (AI answers). Managed in /admin/seo. */
model SeoKeyword {
  id             String    @id @default(cuid())
  phrase         String    @unique
  pillar         String    @default("seo") // seo | aeo | geo
  intent         String    @default("informational") // informational | commercial | transactional | navigational
  targetPath     String? // our page meant to rank, e.g. /learn/what-is-geo
  priority       Int       @default(2) // 1 high · 2 medium · 3 low
  googlePosition Int? // last seen position on Google (1–100), null = not in top 100 / unknown
  aiMentioned    Boolean? // were we named when this was asked to AI assistants
  notes          String?
  checkedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([priority])
}

// ---- Public API + MCP + Looker Studio (agent 4) ----

/** Organization-level API key for the read-only public API (/api/v1) and MCP (/api/mcp). Only a SHA-256 hash is stored. */
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String // first characters of the key, shown in settings to tell keys apart (e.g. "mwr_AbC123xy")
  keyHash        String    @unique // SHA-256 hex of the full key; the key itself is shown once and never stored
  scopes         String[]  @default(["read"]) // read only for now
  createdById    String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, revokedAt])
}

// ---- Search Console keywords + Google Business Profile monitor (agent 6) ----

/** A Search Console query the user starred to watch on the Keywords "Tracked" tab (limit per plan, per organization). */
model KeywordStar {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  query          String
  createdById    String?
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, query])
  @@index([organizationId, projectId])
}

/** The Google Maps place (Places API) the owner picked as their business. One per project. */
model BusinessProfile {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String    @unique
  placeId        String
  name           String
  address        String?
  createdById    String?
  lastSnapshotAt DateTime?
  lastAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots BusinessProfileSnapshot[]

  @@index([organizationId])
}

/** One Places API (New) read of the business: headline numbers + normalized details (data) + checklist. */
model BusinessProfileSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  profileId      String
  placeId        String
  rating         Float?
  reviewCount    Int?
  businessStatus String?
  data           Json // normalized PlaceSnapshot (src/lib/business-profile/places.ts)
  trigger        String   @default("schedule") // schedule | manual | select
  takenAt        DateTime @default(now())

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([organizationId, profileId, takenAt])
}

// ---- Audit depth: real page speed (PageSpeed Insights) + post-crawl probes ----
/** One post-crawl "audit depth" pass per crawl: PageSpeed Insights tests, image-size / redirect / canonical probes, sitemap-vs-noindex. */
model AuditDepthRun {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  crawlRunId     String    @unique
  status         String    @default("queued") // queued | running | succeeded | partial | failed
  psiPlanned     Int       @default(0)
  psiDone        Int       @default(0)
  probes         Json? // ProbeResult[] (src/lib/pagespeed/types.ts): image sizes, link and canonical targets
  sitemapNoindex Json? // string[]: crawled noindex pages listed in the sitemap; null = not checked
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  crawlRun CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
}

/** One Google PageSpeed Insights result for a page (mobile, plus desktop for the homepage). Times in ms. */
model PageSpeedResult {
  id               String   @id @default(cuid())
  organizationId   String
  projectId        String
  crawlRunId       String
  url              String
  strategy         String // mobile | desktop
  status           String   @default("pending") // pending | ok | failed
  attempts         Int      @default(0)
  isHome           Boolean  @default(false)
  performanceScore Int? // Lighthouse performance 0-100 (lab)
  labLcpMs         Int?
  labCls           Float?
  labTbtMs         Int?
  labFcpMs         Int?
  fieldLcpMs       Int? // CrUX p75 (real Chrome users, last 28 days)
  fieldInpMs       Int?
  fieldCls         Float?
  fieldFcpMs       Int?
  fieldScope       String? // url | origin | null (no field data)
  error            String?
  fetchedAt        DateTime?
  createdAt        DateTime @default(now())

  crawlRun CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@unique([crawlRunId, url, strategy])
  @@index([organizationId, projectId, createdAt])
}

// ---- AI bot visits + IndexNow (Agent 5) ----

/** Daily AI/search crawler visits per bot, aggregated from uploaded server logs or the ingest endpoint. Never raw lines or IPs. */
model AiBotDaily {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  date           String // YYYY-MM-DD (UTC)
  bot            String // user-agent token, e.g. GPTBot
  hits           Int      @default(0)
  verifiedHits   Int      @default(0) // IP inside the operator's published ranges
  unverifiedHits Int      @default(0) // ranges known, IP outside them (likely a fake bot)
  statusCounts   Json // { "200": n, "404": m, ... }
  topPaths       Json // [{ path, hits, errors }] top 100 by hits
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, bot])
  @@index([organizationId, projectId, date])
}

/** One processed log file or ingest batch (dedupe by content hash; summary counts only). */
model AiBotLogImport {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  source         String // upload | ingest
  fileName       String?
  sha256         String?
  bytes          Int      @default(0)
  linesTotal     Int      @default(0)
  linesParsed    Int      @default(0)
  botHits        Int      @default(0)
  firstDate      String?
  lastDate       String?
  createdById    String?
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sha256])
  @@index([organizationId, projectId, createdAt])
}

/** Per-project secret for POST /api/projects/[id]/ai-bots/ingest. Only a SHA-256 hash is stored. */
model AiBotIngestKey {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String    @unique
  tokenHash      String    @unique
  tokenPrefix    String // first characters, shown so people can tell keys apart
  createdById    String?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/** IndexNow set-up for a customer's site: the key (public by design) and whether its key file was verified. */
model IndexNowSite {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String    @unique
  host           String
  key            String
  status         String    @default("pending") // pending | verified | failed
  enabled        Boolean   @default(false) // only true after the key file was verified
  onFixPublished Boolean   @default(true)
  onCrawlChanges Boolean   @default(true)
  verifiedAt     DateTime?
  lastCheckAt    DateTime?
  lastCheckError String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/** IndexNow submission log: queued URLs, then the result of the (batched) POST. */
model IndexNowSubmission {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  host           String
  trigger        String // fix_published | crawl_changes | manual
  urls           Json // string[]
  urlCount       Int       @default(0)
  status         String    @default("queued") // queued | sent | merged (sent with an earlier batch) | failed | skipped
  httpStatus     Int?
  message        String?
  attempts       Int       @default(0)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
  @@index([host, status, sentAt])
}

// ---- Alerts + report builder (agent 3) ----
/** Per-project alert rules, channels, recipients and digest choice (src/lib/alerts/config.ts). Absent = defaults (all on). */
model AlertSettings {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String   @unique
  config         Json // { rules: { <ruleId>: { enabled, threshold? } }, channels: { inApp, email, whatsapp }, recipients: userId[], digest }
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/** One alert that fired (history + 24h de-duplication + daily digest queue). */
model AlertEvent {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  rule           String // score_drop | new_urgent_problem | site_down | ai_mention_drop | ai_question_change | indexing_blocked | search_clicks_drop
  dedupeKey      String // same rule + key is not sent again within the rule's cooldown (24h; 7 days for weekly clicks)
  severity       String    @default("warning") // urgent | warning | info
  title          String
  body           String
  link           String?
  data           Json?
  status         String    @default("sent") // sent | pending_digest | in_app_only
  channels       Json? // channels actually used, e.g. ["in_app","email"]
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
  @@index([projectId, rule, dedupeKey, createdAt])
  @@index([status, createdAt])
}

/** Saved client-report layout (sections + order, intro, agency notes, date range). projectId null = organization default. */
model ReportTemplate {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  name           String
  sections       Json // [{ id, enabled }] in display order
  intro          String?
  notes          String? // "notes from the agency" section
  range          Json? // { preset, from?, to? }
  isOrgDefault   Boolean  @default(false)
  shareEnabled   Boolean  @default(false) // reachable through the project's share link (src/lib/share)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
}

// ---- Paid-data features (DataForSEO): shared usage ledger ----
/** One row per DataForSEO call: what it was for, plan units used and the provider-reported cost. Read for monthly allowances. */
model DataForSeoUsage {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  feature        String // rank_tracker | keyword_research | serp_checker | backlinks | competitor_traffic | keyword_gap | link_gap | domain_compare
  units          Int      @default(1)
  costMicros     Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, feature, createdAt])
  @@index([createdAt])
}

// ---- Rank tracker (DataForSEO SERP) ----
/** A keyword the customer tracks on Google for one location + device. Checked on the plan's schedule (src/lib/rank-tracker). */
model TrackedKeyword {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  keyword        String // normalised (lower-case, single spaces)
  locationId     String    @default("in") // id from src/lib/dataforseo/locations.ts
  device         String    @default("mobile") // mobile | desktop
  language       String    @default("en") // en | hi
  active         Boolean   @default(true)
  createdById    String?
  lastCheckedAt  DateTime?
  lastPosition   Int? // null = not in the top 100 (or never checked: see lastCheckedAt)
  bestPosition   Int?
  lastUrl        String? // copies of the latest check, so the table needs no per-keyword history query
  lastFeatures   Json?
  lastCompetitors Json?
  lastError      String?
  createdAt      DateTime  @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checks  RankCheck[]

  @@unique([projectId, keyword, locationId, device])
  @@index([organizationId, projectId])
  @@index([projectId, active, lastCheckedAt])
}

/** One Google check of a tracked keyword: our position (null = not in the top 100), the ranking URL, SERP features and who is above us. */
model RankCheck {
  id               String   @id @default(cuid())
  organizationId   String
  trackedKeywordId String
  checkedAt        DateTime @default(now())
  position         Int?
  url              String?
  serpFeatures     Json? // string[]: ai_overview | local_pack | featured_snippet | people_also_ask | ...
  competitors      Json? // { domain, position }[]: up to 3 domains ranking above us
  trigger          String   @default("schedule") // schedule | manual

  trackedKeyword TrackedKeyword @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)

  @@index([trackedKeywordId, checkedAt])
  @@index([organizationId, checkedAt])
}

/** Per-project rank tracker state: paused when the monthly allowance is used up, and the once-a-day "Check now". */
model RankTrackerState {
  id                String    @id @default(cuid())
  organizationId    String
  projectId         String    @unique
  status            String    @default("active") // active | paused_allowance
  message           String?
  lastRunAt         DateTime?
  lastManualCheckAt DateTime?
  updatedAt         DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---- Keyword research + SERP checker (DataForSEO) ----
/**
 * Shared cache of paid lookups (public Google data, so it is shared across organizations): normalised request key →
 * parsed result. Keyword ideas are reused for 30 days, Google top 10 for 24 hours. No tenant data in here.
 */
model ResearchCache {
  id         String   @id @default(cuid())
  kind       String // keywords | serp
  requestKey String   @unique
  result     Json
  fetchedAt  DateTime @default(now())

  @@index([kind, fetchedAt])
}

/** Per-organization history of keyword / SERP lookups ("Recent searches"). The result itself lives in ResearchCache. */
model ResearchSearch {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  userId         String?
  kind           String // keywords | serp
  query          String
  locationId     String
  languageId     String
  device         String? // serp only: mobile | desktop
  mode           String? // keywords only: suggestions | ideas
  requestKey     String
  resultCount    Int      @default(0)
  fromCache      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, kind, createdAt])
}

// ---- Competitors: traffic estimates, keyword gap, domain comparison, batch traffic ----
/**
 * Cached DataForSEO Labs answers for the Competitors page, so viewing never re-bills. One row per (project, kind, key);
 * a Refresh overwrites it. kind: overview | top_keywords | gap | compare | batch | suggestions.
 * key: what it was for, e.g. "acme.in|in|en" or "rival.in>acme.in|in|en" (batch: a hash of the domain list).
 */
model CompetitorSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  kind           String
  key            String
  locationId     String   @default("in")
  language       String   @default("en")
  data           Json
  costMicros     Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, key])
  @@index([organizationId, projectId, kind, updatedAt])
}

// ---- Backlinks + link gap (DataForSEO Backlinks API) ----
/** Backlink monitoring state per project: created on the first refresh; the scheduler refreshes it per plan. */
model BacklinkMonitor {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String    @unique
  target         String // normalised domain, e.g. acme.in
  lastRefreshAt  DateTime?
  lastAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/** One paid backlink refresh: headline numbers as columns (trend) + parsed lists as JSON (src/lib/backlinks/parse.ts). */
model BacklinkSnapshot {
  id               String   @id @default(cuid())
  organizationId   String
  projectId        String
  target           String
  trigger          String   @default("manual") // manual | schedule
  backlinks        Int?
  referringDomains Int?
  rank             Int?
  data             Json // BacklinkSnapshotData: summary, referringDomains, backlinks, anchors, newLost, sectionErrors
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
}

/** One link-gap lookup: sites linking to competitors but not to the project's domain (domain_intersection). */
model LinkGapReport {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  target         String
  competitors    Json // string[] (1-3 domains)
  items          Json // LinkGapItem[]
  totalCount     Int?
  createdById    String?
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
}
