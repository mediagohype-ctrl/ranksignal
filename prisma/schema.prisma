// Data model — blueprint §7. PostgreSQL (Neon). DATABASE_URL = pooled connection for the app;
// DIRECT_URL = non-pooled connection for migrations. Every tenant-owned row carries organizationId.
// JSON columns are stored as Json; status/enum-like columns are strings validated in code
// (see src/lib/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // non-pooled connection used by prisma migrate
}

model Organization {
  id                String   @id @default(cuid())
  name              String
  region            String   @default("IN")
  billingCustomerId String?
  planId            String   @default("trial") // trial | starter | growth | agency
  status            String   @default("active") // active | past_due | cancelled | suspended
  publishingEnabled Boolean  @default(true) // per-tenant kill switch
  serviceTier       String? // done-for-you tier: fix | grow | authority (null = self-serve)
  branding          Json? // white-label: { displayName, logoUrl, accentColor, replyTo, footerText } (agency plan)
  createdAt         DateTime @default(now())

  memberships   Membership[]
  projects      Project[]
  integrations  Integration[]
  subscriptions Subscription[]
  usage         UsageLedger[]
  auditLogs     AuditLog[]
  workflowRuns  WorkflowRun[]
  notifications Notification[]
  adminNotes    AdminNote[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  emailVerified Boolean  @default(false)
  isStaff       Boolean  @default(false)
  createdAt     DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  role           String    @default("member") // owner | admin | member | viewer
  status         String    @default("active") // active | invited | removed
  invitedAt      DateTime?
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  websiteUrl     String
  brandNames     Json?      // string[] brand name + aliases
  categories     Json?      // product/service categories
  audience       String?
  countries      Json?     
  languages      Json?     
  competitors    Json?      // {name, domain, aliases[]}[]
  keywords       Json?     
  settings       Json?      // crawl limits, schedules, automation permissions
  createdAt      DateTime @default(now())

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources     Resource[]
  crawlRuns     CrawlRun[]
  findings      AuditFinding[]
  prompts       TrackedPrompt[]
  visibilityRuns VisibilityRun[]
  actions       Action[]
  integrations  Integration[]
  snapshots     ReportSnapshot[]
  tasks         Task[]
  monthlyReports MonthlyReport[]
  offsiteItems  OffsiteItem[]
  dailyMetrics  MetricDaily[]

  @@index([organizationId])
}

model Integration {
  id                  String    @id @default(cuid())
  organizationId      String
  projectId           String?
  provider            String // wordpress | github | gsc | manual | crawler
  credentialEncrypted String? // AES-GCM ciphertext; never logged or sent to client
  scopes              Json?      
  capabilities        Json?       // capability snapshot
  health              String    @default("unknown") // healthy | degraded | failed | unknown
  connectorVersion    String    @default("1")
  config              Json?       // non-secret config, e.g. siteUrl
  connectedBy         String?
  lastSyncAt          DateTime?
  createdAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
}

model Resource {
  id                 String   @id @default(cuid())
  organizationId     String
  projectId          String
  canonicalUrl       String
  resourceType       String   @default("page")
  cmsResourceId      String?
  lastSeen           DateTime @default(now())
  status             String   @default("active")
  contentFingerprint String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, canonicalUrl])
  @@index([organizationId])
}

model CrawlRun {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  workflowRunId  String?
  status         String    @default("queued")
  pagesFound     Int       @default(0)
  pagesCrawled   Int       @default(0)
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages   CrawlPage[]

  @@index([organizationId, projectId, createdAt])
}

model CrawlPage {
  id              String   @id @default(cuid())
  organizationId  String
  crawlRunId      String
  url             String
  finalUrl        String?
  statusCode      Int?
  redirectChain   Json?     
  contentType     String?
  responseBytes   Int?
  extracted       Json?      // title, description, headings, canonical, robotsMeta, links, images, jsonLd, wordCount
  error           String?
  crawledAt       DateTime @default(now())

  crawlRun CrawlRun       @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  findings AuditFinding[]

  @@index([crawlRunId])
}

model AuditFinding {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  crawlPageId    String?
  pageUrl        String?
  category       String // technical | content | metadata | schema | indexability | links | ai_readiness
  code           String // stable rule id e.g. missing_meta_description
  severity       String // critical | high | medium | low | info
  confidence     Float     @default(1)
  message        String
  evidence       Json?      
  status         String    @default("open") // open | resolved | ignored
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crawlPage CrawlPage? @relation(fields: [crawlPageId], references: [id], onDelete: SetNull)

  @@index([organizationId, projectId, status])
}

model TrackedPrompt {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  text           String
  intent         String   @default("informational") // informational | commercial | comparison | navigational | transactional
  topic          String?
  locale         String   @default("en-IN")
  targetProvider String   @default("all")
  priority       Int      @default(2)
  active         Boolean  @default(true)
  promptSetVersion Int    @default(1)
  createdAt      DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@index([organizationId, projectId, active])
}

model VisibilityRun {
  id               String    @id @default(cuid())
  organizationId   String
  projectId        String
  workflowRunId    String?
  status           String    @default("queued")
  providers        Json?      
  promptSetVersion Int       @default(1)
  sampleSize       Int       @default(0)
  collected        Int       @default(0)
  failed           Int       @default(0)
  costMicros       Int       @default(0) // cost in micro-USD
  metrics          Json?       // computed VisibilityMetrics snapshot
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@index([organizationId, projectId, createdAt])
}

model Observation {
  id                String   @id @default(cuid())
  organizationId    String
  visibilityRunId   String
  promptId          String
  provider          String // e.g. openai, dataforseo, simulated
  platformLabel     String // e.g. "ChatGPT (API: gpt-4o-mini)"
  model             String?
  locale            String?
  rawResponse       String // raw answer text (large payloads → object storage later)
  rawPayloadRef     String?
  citations         Json?      // {url, domain, title?, ownedByCustomer}[]
  brandMentioned    Boolean  @default(false)
  brandRecommended  Boolean  @default(false)
  brandCited        Boolean  @default(false)
  competitorMentions Json?     // name -> count
  sentiment         String?  // positive | neutral | negative
  parseConfidence   Float    @default(1)
  limitations       String?
  costMicros        Int      @default(0)
  simulated         Boolean  @default(false) // true for demo provider — always labelled in UI
  createdAt         DateTime @default(now())

  visibilityRun VisibilityRun @relation(fields: [visibilityRunId], references: [id], onDelete: Cascade)
  prompt        TrackedPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([organizationId, visibilityRunId])
  @@index([visibilityRunId, createdAt])
  @@index([promptId])
}

model Action {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  type           String // update_meta_description | update_title | add_faq_schema | content_brief | ...
  target         Json?       // {resourceType, resourceId, url}
  rationale      String
  evidenceRefs   Json?      
  priority       String    @default("medium") // critical | high | medium | low
  priorityScore  Float     @default(0)
  expectedImpact String?
  effort         String    @default("low")
  confidence     Float     @default(0.5)
  riskClass      String    @default("C") // A | B | C | D
  policyDecision String    @default("approval_required") // auto_execute | approval_required | blocked
  policyReason   String?
  policyVersion  String    @default("1")
  proposedChange Json?       // {field, before, after}
  draftHash      String?
  status         String    @default("proposed") // proposed | awaiting_approval | approved | rejected | expired | executing | succeeded | succeeded_with_warnings | failed | rollback_pending | rolled_back | rollback_failed | blocked | cancelled
  integrationId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvals  Approval[]
  executions ActionExecution[]

  @@index([organizationId, projectId, status])
}

model Approval {
  id          String    @id @default(cuid())
  organizationId String
  actionId    String
  requestedBy String?
  approverId  String?
  draftHash   String
  decision    String    @default("pending") // pending | approved | rejected | expired | invalidated
  comments    String?
  expiresAt   DateTime
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
}

model ActionExecution {
  id              String    @id @default(cuid())
  organizationId  String
  actionId        String
  connector       String
  idempotencyKey  String    @unique
  beforeState     Json?
  expectedVersion String?
  result          String    @default("pending") // pending | success | partial | failure
  resultDetail    Json?      
  validation      String?   // passed | warning | failed
  rollbackStatus  String?   // not_needed | pending | rolled_back | failed | manual_required
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
}

model WorkflowRun {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String?
  kind           String // crawl | visibility | analyze | execute_action | rollback | scheduled
  version        String    @default("1")
  state          String    @default("queued") // see WorkflowState in src/lib/types.ts
  idempotencyKey String?   @unique
  input          Json?      
  output         Json?      
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAfter       DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  error          String?
  errorClass     String?   // transient | permanent | policy | quota
  usage          Json?      
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       WorkflowEvent[]

  @@index([state, runAfter])
  @@index([organizationId, projectId])
}

model WorkflowEvent {
  id            String   @id @default(cuid())
  workflowRunId String
  name          String // e.g. crawl.started — see Appendix A event names
  fromState     String?
  toState       String?
  data          Json?     
  createdAt     DateTime @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
}

model Subscription {
  id                     String    @id @default(cuid())
  organizationId         String
  provider               String    @default("razorpay") // razorpay | stripe
  providerCustomerId     String?
  providerSubscriptionId String?   @unique
  planId                 String
  status                 String // trialing | active | past_due | cancelled | expired
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model UsageLedger {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  provider       String // openai | dataforseo | crawler | simulated
  taskType       String // crawl_page | visibility_prompt | llm_analysis | content_generation
  runId          String?
  kind           String   @default("actual") // reservation | actual | release
  credits        Int
  costMicros     Int      @default(0)
  billingPeriod  String // YYYY-MM
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, billingPeriod])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, eventId]) // replay protection / idempotency
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  actorType      String   @default("user") // user | system | staff
  action         String
  resourceType   String?
  resourceId     String?
  before         Json?
  after          Json?
  requestId      String?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  type           String // approval_requested | change_completed | job_failed | usage_threshold | monthly_report
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, readAt])
}

model FeatureFlag {
  key       String   @id // e.g. global.publishing, provider.openai, action.update_meta_description
  enabled   Boolean  @default(true)
  note      String?
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------------------------
// Round 4: measurement history, service delivery, monthly impact reports, admin records.

/** Frozen scores after each successful crawl / visibility run, so change over time can be shown. */
model ReportSnapshot {
  id                 String   @id @default(cuid())
  organizationId     String
  projectId          String
  kind               String // crawl | visibility
  crawlRunId         String?
  visibilityRunId    String?
  overallScore       Int?
  grade              String?
  pillarScores       Json? // { seo, aeo, geo, brand } -> number | null
  openIssues         Json? // { critical, high, medium, low, info, total }
  visibility         Json? // VisibilityMetrics subset (rates, index, competitorShare, sampleSize, providers)
  promptSetVersion   Int?
  methodologyVersion String
  simulated          Boolean  @default(false)
  report             Json? // full SiteReport built once when the run finished (served to report pages)
  createdAt          DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
  @@index([projectId, kind, createdAt])
}

/** Work items for the service team or the client (on-site fixes, content, off-site, reporting). */
model Task {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  actionId       String?
  findingId      String?
  title          String
  description    String?
  category       String    @default("onsite") // onsite | content | technical | offsite | reporting | other
  performedBy    String    @default("agency") // agency | client | system
  assigneeId     String?
  createdById    String?
  status         String    @default("backlog") // backlog | in_progress | client_review | done | blocked | cancelled
  priority       String    @default("medium") // high | medium | low
  dueAt          DateTime?
  completedAt    DateTime?
  clientVisible  Boolean   @default(true)
  shippedUrl     String?
  evidence       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments TaskComment[]

  @@index([organizationId, projectId, status])
  @@index([projectId, completedAt])
}

model TaskComment {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  authorId       String?
  body           String
  internal       Boolean  @default(false) // staff-only note, hidden from client viewers
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/** One impact report per project per month: drafted automatically, reviewed by staff, then sent. */
model MonthlyReport {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  period         String // YYYY-MM
  status         String    @default("draft") // draft | reviewed | sent
  payload        Json? // frozen report data (see src/lib/monthly-report/types.ts)
  summary        String? // editable narrative
  reviewedById   String?
  reviewedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, period])
  @@index([organizationId, period])
}

/** Inbound leads: free checks and contact-form messages (admin CRM). */
model Lead {
  id        String   @id @default(cuid())
  source    String // free_check | contact | signup_intent
  email     String?
  name      String?
  company   String?
  url       String?
  message   String?
  score     Int?
  ipHash    String?
  status    String   @default("new") // new | contacted | qualified | converted | closed
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, createdAt])
  @@index([status, createdAt])
}

/** Internal staff notes on a customer organization. */
model AdminNote {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/** Off-site GEO work: directory listings, review platforms, PR mentions, forums, entity profiles. */
model OffsiteItem {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  type           String // directory | review_platform | pr_mention | forum_thread | wikidata | social_profile | best_list | other
  name           String // e.g. "Justdial", "G2", "Inc42 article"
  url            String?
  status         String    @default("todo") // todo | submitted | live | rejected
  napConsistent  Boolean? // name/address/phone matches the site
  source         String    @default("manual") // manual | ai_citation (suggested from domains AI already cites)
  taskId         String?
  notes          String?
  liveAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, status])
}

/** Daily first-party metrics from Google Search Console / GA4 (and later others). */
model MetricDaily {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  source         String // gsc | ga4
  date           String // YYYY-MM-DD
  dimension      String   @default("total") // total | query | page | channel
  key            String   @default("") // the query, page URL or channel name ("" for total)
  clicks         Int?
  impressions    Int?
  ctr            Float?
  position       Float?
  sessions       Int?
  conversions    Int?
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, source, date, dimension, key])
  @@index([organizationId, projectId, source, date])
}
