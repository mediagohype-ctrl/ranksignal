{
  "manifest_version": 3,
  "name": "MyWebRank SEO Check",
  "short_name": "MyWebRank",
  "version": "0.1.0",
  "description": "Check any page's SEO and AI readiness in one click: title, description, headings, schema, share tags and AI robot rules.",
  "homepage_url": "https://mywebrank.tech/tools/seo-extension",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Check this page with MyWebRank",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
